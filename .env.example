# ===========================================================================
# AgileIQ — .env.example
#
# MODÈLE de configuration. Ce fichier EST versionné (sans vraie valeur).
# Pour l'utiliser :  cp .env.example .env  puis renseigner les valeurs.
# Le vrai fichier .env n'est JAMAIS committé (voir .gitignore).
# ===========================================================================

# --- Environnement applicatif ---------------------------------------------
# Valeurs possibles : development | testing | production
APP_ENV=development
FLASK_DEBUG=1

# --- Secrets applicatifs --------------------------------------------------
# EN PRODUCTION : générer des valeurs aléatoires fortes, ex :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-dev-secret-key
JWT_SECRET_KEY=change-me-dev-jwt-secret-key

# Durées de vie des tokens JWT (en secondes)
JWT_ACCESS_TOKEN_EXPIRES=900        # 15 minutes
JWT_REFRESH_TOKEN_EXPIRES=2592000   # 30 jours

# --- Base de données PostgreSQL -------------------------------------------
POSTGRES_USER=agileiq
POSTGRES_PASSWORD=change-me-dev-password
POSTGRES_DB=agileiq

# URL complète utilisée par SQLAlchemy.
# Le hôte "postgres" = nom du service dans docker-compose.
DATABASE_URL=postgresql+psycopg://agileiq:change-me-dev-password@postgres:5432/agileiq

# --- Redis ----------------------------------------------------------------
# Le hôte "redis" = nom du service dans docker-compose.
REDIS_URL=redis://redis:6379/0
# Bases Redis dédiées (on isole les usages)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
RATELIMIT_STORAGE_URI=redis://redis:6379/3

# --- CORS (frontend React, ajouté en Phase 7) -----------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Logs -----------------------------------------------------------------
# Niveau : DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG
# Format : json (prod) | console (dev lisible)
LOG_FORMAT=console

# --- Intégrations externes (renseignées en Phase 2) -----------------------
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_API_TOKEN=
TAIGA_API_URL=
TAIGA_API_TOKEN=

# --- Service ML (ajouté en Phase 3) ---------------------------------------
ML_SERVICE_URL=http://ml-service:8001
ML_SERVICE_TOKEN=change-me-ml-internal-token
